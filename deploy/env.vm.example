NODE_ENV=production
PORT=3000

POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://oraculo:troque-esta-senha@oraculo-db:5432/oraculo

MODEL_PROVIDER=cli
# teto de tipos de provedor: o banco só cadastra/ativa dentro desta lista, nunca amplia
PROVEDORES_PERMITIDOS=openai-compat,cli,anthropic
CLI_COMANDO=/usr/local/bin/agy
CLI_DIALETO=agy
CLI_MODELO=gemini-3.6-flash-medium
CLI_TIMEOUT_MS=180000

RETRIEVAL_MODE=hibrido
EMBEDDING_MODELO=Xenova/multilingual-e5-small
EMBEDDING_DIMENSOES=384

CORPUS_FONTES=/corpus/oraculo-workspace/memoria,/corpus/claude-workspace-config,/corpus/oraculo-workspace/docs,/corpus/infra,/corpus/projects
CAMINHO_EXIBICAO=/corpus/notas=/home/ubuntu/oraculo-notas,/corpus=/home/ubuntu
CORPUS_NEGADOS=secrets*,.env*,*.key,*.pem,*.p12,id_rsa*,*token*,*.sqlite,dsg-workspace,cast-workspace,.cache,kubejs,dynamic-data-pack-cache,bluemap,world,backups,site,dist,assets,coverage,logs
DIRETORIO_NOTAS=/corpus/notas

CAP_CONHECIMENTO=on
CAP_CODIGO=on
CAP_ESTADO=off
# ids do catálogo fechado de diagnóstico — nunca linhas de shell
ESTADO_COMANDOS=servicos_ativos,servico_logs,portas_escutando,recursos_maquina,estado_containers
CAP_BANCO=off

CODIGO_REPOS=/corpus/oraculo-workspace/repos

AUTH_MODE=local
JWT_SECRET=troque-por-32-caracteres-ou-mais-aqui
JWT_TTL=12h

ENGINE_MAX_ITERACOES=8
ENGINE_MAX_TOKENS_SAIDA=4000

GITHUB_USUARIO=icaroMelo1
USUARIO_DONO=ubuntu
