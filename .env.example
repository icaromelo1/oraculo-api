NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://oraculo:oraculo@localhost:5434/oraculo

MODEL_PROVIDER=cli
CLI_COMANDO=agy
CLI_DIALETO=auto
CLI_MODELO=gemini-3.6-flash-low
CLI_TIMEOUT_MS=120000
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-4-5-20251001
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELO=

RETRIEVAL_MODE=hibrido
EMBEDDING_MODELO=Xenova/multilingual-e5-small
EMBEDDING_DIMENSOES=384

CORPUS_FONTES=/home/ubuntu/.claude/projects/-home-ubuntu/memory,/home/ubuntu/claude-workspace-config,/home/ubuntu/oraculo-workspace/docs,/home/ubuntu/infra,/home/ubuntu/projects
CORPUS_NEGADOS=secrets*,.env*,*.key,*.pem,*.p12,id_rsa*,*token*,*.sqlite,dsg-workspace,cast-workspace

CAP_CONHECIMENTO=on
CAP_CODIGO=on
CAP_ESTADO=off
CAP_BANCO=off

CODIGO_REPOS=/home/ubuntu/oraculo-workspace/repos
ESTADO_COMANDOS=
BANCO_ALVOS=

AUTH_MODE=local
JWT_SECRET=troque-por-32-caracteres-ou-mais-aqui
JWT_TTL=12h

GUARD_MODE=off

ENGINE_MAX_ITERACOES=8
ENGINE_MAX_TOKENS_SAIDA=4000

GITHUB_TOKEN=
GITHUB_USUARIO=icaroMelo1
