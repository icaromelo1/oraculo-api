NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://oraculo:oraculo@localhost:5434/oraculo

MODEL_PROVIDER=cli
# teto de tipos de provedor: o banco só cadastra/ativa dentro desta lista, nunca amplia
# Trava o provedor desta instalação: a tela Ambiente mostra a configuração, mas
# recusa qualquer alteração — inclusive do perfil dono. Para mudar, edite este
# arquivo no servidor e reinicie a API.
# Deixe ausente ou 'false' se quiser configurar o provedor pela tela (é o padrão,
# e o que permite a quem clonar o Oráculo montar do próprio jeito).
PROVEDOR_TRAVADO=false

PROVEDORES_PERMITIDOS=openai-compat,cli,anthropic
CLI_COMANDO=agy
CLI_DIALETO=auto
CLI_MODELO=gemini-3.6-flash-medium
CLI_TIMEOUT_MS=120000
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-4-5-20251001
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELO=

RETRIEVAL_MODE=hibrido
EMBEDDING_MODELO=Xenova/multilingual-e5-small
EMBEDDING_DIMENSOES=384

CORPUS_FONTES=./exemplos/corpus
# fora do container os caminhos já são os reais — a tradução só é necessária na VM
# (ver deploy/env.vm.example)
CAMINHO_EXIBICAO=
CORPUS_NEGADOS=secrets*,.env*,*.key,*.pem,*.p12,id_rsa*,*token*,*.sqlite,dsg-workspace,cast-workspace
DIRETORIO_NOTAS=./exemplos/notas

CAP_CONHECIMENTO=on
CAP_CODIGO=on
CAP_ESTADO=off
CAP_BANCO=off

CODIGO_REPOS=
ESTADO_COMANDOS=servicos_ativos,servico_logs,portas_escutando,recursos_maquina,estado_containers
BANCO_ALVOS=

AUTH_MODE=local
JWT_SECRET=troque-por-32-caracteres-ou-mais-aqui
JWT_TTL=12h

CONFIG_SECRET=


ENGINE_MAX_ITERACOES=8
ENGINE_MAX_TOKENS_SAIDA=4000

GITHUB_TOKEN=
GITHUB_USUARIO=icaroMelo1
USUARIO_DONO=ubuntu
